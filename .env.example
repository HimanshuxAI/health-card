# Signing secret shared by the five services and the gateway.
# Change both values before running this stack anywhere other than a laptop.
JWT_SECRET=demo-secret-change-me
SHARED_TOKEN=internal-demo-token

# Optional. Fill these in to send real email when an SOS alert fires.
# Without them the alert still reaches every hospital dashboard and the email
# status reads SKIPPED.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SOS_FROM_EMAIL=
